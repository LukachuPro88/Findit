git_msg = "Bump version to "

task shared_release_pipeline {
    ask next_version "Confirm version to tag (e.g. 1.0.0): "

    confirm "Are you sure you want to publish this version?" {
        exec "sed -i \"s/^version = \\\".*\\\"/version = \\\"\"" + next_version + "\"\\\"/\" Cargo.toml"
        exec "cargo test -- --test-threads=1"
        exec "git add Cargo.toml Cargo.lock"
        exec "git commit -m '" + git_msg + next_version + "'"
        exec "git tag -a v" + next_version + " -m 'Release v" + next_version + "'"
        exec "git push origin main --tags"
        exec "cargo publish"
    }
}ask shared_release_pipeline {
    ask next_version "Confirm version to tag (e.g. 1.0.0): "

    if 

    confirm "Are you sure you want to publish this version?" {
        exec "sed -i \"s/^version = \\\".*\\\"/version = \\\"\"" + next_version + "\"\\\"/\" Cargo.toml"
        exec "cargo test -- --test-threads=1"
        exec "git add Cargo.toml Cargo.lock"
