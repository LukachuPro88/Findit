        exec "git tag -a v" + next_version + " -m 'Release v" + next_version + "'"
        exec "git push origin main --tags"
        exec "cargo publish"
    }
}

task major {
    exec "echo 'Current Version:'"
    exec "grep '^version' Cargo.toml"
    call shared_release_pipeline
}

task minor {
    exec "echo 'Current Version:'"
    exec "grep '^version' Cargo.toml"
    call shared_release_pipeline
}

task patch {
    exec "echo 'Current Version:'"
    exec "grep '^version' Cargo.toml"
    call shared_release_pipeline
}
